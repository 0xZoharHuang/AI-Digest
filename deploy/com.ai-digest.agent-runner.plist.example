<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ai-digest.agent-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string><string>-m</string><string>ai_digest.cli</string>
    <string>agent-worker</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>CODEX_HOME</key><string>__CODEX_HOME__</string>
    <key>AI_DIGEST_RUNTIME_ROOT</key><string>__SHARED__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>QueueDirectories</key>
  <array><string>__SHARED__/jobs</string></array>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__SHARED__/logs/agent-runner.log</string>
  <key>StandardErrorPath</key><string>__SHARED__/logs/agent-runner.error.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>

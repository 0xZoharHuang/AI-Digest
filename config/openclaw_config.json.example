  "_comments": {
    "github_token": "Get from https://github.com/settings/tokens (repo + user read permissions). Can reuse from github_config.json.",
    "days_back": "How many days to look back (default: 3, slightly more than the 2-day schedule interval for overlap)",
    "min_importance": "Minimum importance score to include (1-10, default: 5)",
    "model": "Claude model: sonnet (recommended), opus (thorough), haiku (fast)",
    "sync_to_notion": "Auto-sync to Notion (requires openclaw_database_id in notion_config.json)",
    "tracked_repos": "Specific repos to track releases/commits",
    "tracked_org": "GitHub org to scan for all repos"
  }
}
